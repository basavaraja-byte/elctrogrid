# Application Configuration
APP_NAME=DISPATCHGRID
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1

# Supabase PostgreSQL Database URL (psycopg v3 driver with SSL)
# Format (Session Pooler - Port 5432 recommended for prepared statements and SQLAlchemy):
# postgresql+psycopg://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
TEST_DATABASE_URL=sqlite:///./test_dispatchgrid.db

# Supabase API Credentials (from Project Settings -> API)
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGci...[ANON_PUBLIC_KEY]
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...[SERVICE_ROLE_KEY]
SUPABASE_JWT_SECRET=[JWT_SECRET_FROM_SUPABASE_DASHBOARD]

# CORS Origins (comma-separated allowed web clients)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://elctrogrid.vercel.app

# Shift & Scheduling Policies
ALLOW_OVERNIGHT_SHIFTS=false
LOCAL_TIMEZONE_OFFSET_MINUTES=330

# Documented Multi-Criteria Heuristic Scoring Weights (Must sum to 1.0)
WEIGHT_TRAVEL_TIME=0.25
WEIGHT_SLA_RISK=0.30
WEIGHT_JOB_PRIORITY=0.15
WEIGHT_WORKLOAD_BALANCE=0.15
WEIGHT_SCHEDULE_STABILITY=0.15

# Razorpay Standard Checkout (Test Mode Only)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_secret_placeholder_secret
PAYMENT_MODE=test
DEMO_PAYMENT_ENABLED=true
