DISPATCHGRID_WEIGHT_WORKLOAD=0.20
DISPATCHGRID_WEIGHT_RECOVERY_CHANGE=0.10
DISPATCHGRID_OPTIMIZER_MAX_ITERATIONS=100
DISPATCHGRID_OPTIMIZER_MAX_RUNTIME_SEC=5.0

