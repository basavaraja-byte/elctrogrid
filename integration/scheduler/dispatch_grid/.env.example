# DispatchGrid Scheduler & Assignment Optimization Configuration
DISPATCHGRID_DATA_DIR=data
DISPATCHGRID_SLA_MODE=hard
DISPATCHGRID_ALLOW_COORDINATE_TRAVEL_FALLBACK=true
DISPATCHGRID_ALLOW_OVERTIME=false
DISPATCHGRID_URGENCY_HORIZON_MIN=240
